{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "reload_style_on_change": true,
    "include": [
        "~/.config/waybar/modules.json"
    ],
    "modules-left": [
        "hyprland/window",
        "custom/empty"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/herdr",
        "custom/gome",
        "pulseaudio",
        "bluetooth",
        "network",
        "image#tailscale",
        "image#cisco",
        "image#pia",
        "battery",
        "custom/hypridle",
        "group/webex",
        "custom/notification",
        "clock"
    ]
}
